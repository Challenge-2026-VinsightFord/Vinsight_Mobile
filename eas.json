{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "entrega": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_USE_MOCK": "true",
        "EXPO_PUBLIC_ATALHOS_DEMO": "true"
      }
    },
    "api": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_USE_MOCK": "false",
        "EXPO_PUBLIC_ATALHOS_DEMO": "true"
      }
    }
  }
}
