# Configuração do app (lida pelo Expo na inicialização; reinicie o `expo start` após mudar).
# Para valores só da sua máquina, crie um .env.local (ignorado pelo git).

# true = usa os dados de src/api/mock, sem rede. Útil se a API estiver fora do ar.
EXPO_PUBLIC_USE_MOCK=false

# Vazio = detecta sozinho (IP do PC que roda o Metro; localhost no navegador).
# Obrigatório no APK de release, que não tem Metro.
EXPO_PUBLIC_API_URL=
